---
import Base from "../layouts/Base.astro";
import "../butterfly/butterfly.css";
---

<Base
  title="The Butterfly Effect"
  description="An interactive narrative where ordinary decisions lead to extraordinary consequences."
>
  <p class="eyebrow"><a href="/built">Things I've Built</a></p>
  <div id="butterfly"></div>

  <section class="section" id="about" aria-labelledby="about-title">
    <h2 id="about-title">About the experience</h2>
    <div class="prose">
      <p>One voicemail starts three different days. Follow a choice to its ending, then return to an earlier moment and see where a different choice takes you.</p>
      <p>Progress stays in this browser. You can change the reading size or reveal the whole scene at any time.</p>
    </div>
  </section>
</Base>

<script>
  import { mount } from "../butterfly/play.ts";

  const root = document.getElementById("butterfly");
  if (root) mount(root);
</script>
