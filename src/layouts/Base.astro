---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  shareImage?: string;
  shareImageAlt?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  shareImage = "/social/portfolio.png",
  shareImageAlt = "Prateek Alakh — Curiosity takes me places.",
  ogType = "website",
} = Astro.props;
const pageTitle = title === "Prateek Alakh" ? title : `${title} — Prateek Alakh`;
const year = new Date().getFullYear();
const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const canonical = new URL(current, Astro.site ?? Astro.url);
const imageUrl = new URL(shareImage, canonical);

const nav = [
  { href: "/story", label: "My Story" },
  { href: "/built", label: "Things I've Built" },
  { href: "/explored", label: "Things I've Explored" },
  { href: "/curiosity", label: "Curiosity" },
  { href: "/notes", label: "Notes" },
  { href: "/contact", label: "Get in Touch" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:site_name" content="Prateek Alakh" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#070706" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="atmosphere" aria-hidden="true">
      <div class="orb orb-a"></div>
      <div class="orb orb-b"></div>
      <div class="grain"></div>
    </div>
    <div class="cursor-glow" aria-hidden="true"></div>

    <header class="site-header">
      <div class="wrap bar">
        <a class="mark" href="/" aria-label="Prateek Alakh, home">
          <span>PA</span>
        </a>
        <nav class="nav" aria-label="Site">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={current === item.href ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <p class="status"><span class="pulse" aria-hidden="true"></span>Always exploring</p>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap bar">
        <span>© {year} Prateek Alakh</span>
        <span class="footer-end">
          <span>A small window into a much bigger world.</span>
          <button class="signal" type="button" id="first-contact" aria-label="Definitely not attempting extraterrestrial communication.">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <path d="M8 21.5h16M11 21.5l2.2-6.2h5.6L21 21.5" />
              <path d="M16 15.3V9.2" />
              <path d="M16 9.2c2.4-2.6 6.2-2.2 8.2.4M16 9.2C13.6 6.6 9.8 7 7.8 9.6" />
              <circle cx="16" cy="8.2" r="1.1" />
            </svg>
            <span class="signal-tip">Definitely not attempting extraterrestrial communication.</span>
          </button>
        </span>
      </div>
      <p class="signal-error wrap" role="status"></p>
    </footer>

    <script>
      const glow = document.querySelector<HTMLElement>(".cursor-glow");
      const finePointer = window.matchMedia("(pointer: fine)").matches;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (glow && finePointer && !reduceMotion) {
        window.addEventListener(
          "pointermove",
          (event) => {
            glow.style.transform = `translate3d(${event.clientX}px, ${event.clientY}px, 0)`;
          },
          { passive: true },
        );
      } else {
        glow?.remove();
      }

      const signal = document.querySelector<HTMLButtonElement>("#first-contact");
      const signalError = document.querySelector<HTMLElement>(".signal-error");

      signal?.addEventListener("click", async () => {
        if (signalError) signalError.textContent = "";
        try {
          const firstContact = await import("../first-contact/overlay");
          firstContact.openFirstContact(signal);
        } catch {
          if (signalError) {
            signalError.textContent = "Could not open First Contact. Try again after reloading the page.";
          }
        }
      });
    </script>
  </body>
</html>
